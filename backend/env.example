# --- App ---
APP_NAME=Gadgets360 AI Assistant Backend
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# --- CORS (comma-separated origins, or * for all) ---
CORS_ORIGINS=*

# --- Gemini / LLM ---
GEMINI_API_KEY=YOUR_KEY
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_REQUEST_TIMEOUT=30

# --- Gadgets360 upstream APIs ---
GADGETS360_PRODUCTS_API_BASE=https://api.gadgets360.com/products

# --- Pricee Product APIs (real product data source) ---
PRICEE_SEARCH_API_BASE=https://pricee.com/api/v1/search.php
PRICEE_PRODUCT_LIST_API_BASE=https://pricee.com/api/v2/productList.php
PRICEE_API_KEY=YOUR_PRICEE_API_KEY

GADGETS360_REVIEWS_API_BASE=https://search.ndtv.com/news/json/client_key/YOUR_CLIENT_KEY
GADGETS360_REVIEWS_CLIENT_KEY=YOUR_CLIENT_KEY
GADGETS360_NEWS_API_BASE=https://api.gadgets360.com/news
GADGETS360_PRICE_API_BASE=https://api.gadgets360.com/prices
GADGETS360_SEARCH_API_BASE=https://api.gadgets360.com/search
UPSTREAM_API_KEY=YOUR_UPSTREAM_KEY
UPSTREAM_REQUEST_TIMEOUT=15

# --- Session ---
SESSION_MAX_MESSAGES=5
SESSION_INACTIVITY_TTL_SECONDS=1800
SESSION_CLEANUP_INTERVAL_SECONDS=60

# --- Caching ---
CACHE_TTL_PARSER_SECONDS=600
CACHE_TTL_API_SECONDS=120
CACHE_MAX_ENTRIES=1000

# --- Logging ---
LOG_LEVEL=INFO
